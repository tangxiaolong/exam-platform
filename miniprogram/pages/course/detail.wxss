.page {
  padding: 24rpx 24rpx 120rpx;
  box-sizing: border-box;
  background: #f5f7fa;
  min-height: 100vh;
}

.state-box {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
}

.hero {
  background: linear-gradient(135deg, #1d4ed8 0%, #4f46e5 55%, #7c3aed 100%);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  color: #fff;
  box-shadow: 0 12rpx 32rpx rgba(29, 78, 216, 0.25);
}

.hero-title {
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.4;
}

.hero-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 10rpx;
}

.hero-tags {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.hero-tag {
  font-size: 21rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

.hero-summary {
  font-size: 24rpx;
  opacity: 0.9;
  line-height: 1.7;
  margin-top: 18rpx;
}

.hero-btn {
  margin-top: 24rpx;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1d4ed8;
  font-size: 28rpx;
  font-weight: 600;
}

.hero-btn:active {
  opacity: 0.85;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  flex: 1;
  min-width: 0;
}

.card-meta {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.lesson-content {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.8;
  margin-top: 16rpx;
}

.lesson-empty {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 16rpx;
}

.finish-btn {
  margin-top: 22rpx;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  font-size: 27rpx;
  color: #059669;
  background: #ecfdf5;
  border: 1rpx solid #d1fae5;
}

.finish-btn:active {
  opacity: 0.75;
}

.section-head {
  display: flex;
  align-items: center;
  font-size: 31rpx;
  font-weight: 600;
  color: #111827;
  margin: 36rpx 0 0;
}

.title-bar {
  width: 8rpx;
  height: 30rpx;
  border-radius: 8rpx;
  background: #1d4ed8;
  margin-right: 14rpx;
}

.list-card {
  padding: 10rpx 28rpx;
}

.lesson-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.lesson-row:last-child {
  border-bottom: none;
}

.lesson-row:active {
  opacity: 0.75;
}

.lesson-index {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f1f5f9;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.lesson-row.active .lesson-index {
  background: #1d4ed8;
  color: #fff;
}

.lesson-main {
  flex: 1;
  min-width: 0;
}

.lesson-title {
  font-size: 27rpx;
  color: #111827;
  line-height: 1.5;
}

.lesson-duration {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.lesson-play {
  font-size: 30rpx;
  color: #d1d5db;
  margin-left: 12rpx;
}

.lesson-row.active .lesson-title {
  color: #1d4ed8;
  font-weight: 600;
}

.mini-pill {
  display: inline-block;
  font-size: 19rpx;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 8rpx;
  vertical-align: middle;
}

.mini-green {
  color: #059669;
  background: #ecfdf5;
}

.mini-gray {
  color: #6b7280;
  background: #f3f4f6;
}
