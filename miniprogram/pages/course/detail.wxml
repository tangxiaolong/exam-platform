<view class="page">
  <view wx:if="{{loading}}" class="state-box">加载中…</view>
  <view wx:elif="{{!course}}" class="state-box">课程不存在</view>

  <block wx:else>
    <view class="hero">
      <view class="hero-title">{{course.title}}</view>
      <view class="hero-sub">{{course.lecturer || '平台讲师'}} · {{course.lessonCount}} 课时</view>
      <view class="hero-tags">
        <view class="hero-tag">{{course.accessType === 'FREE' ? '免费课程' : '需购买'}}</view>
        <view wx:if="{{course.finishedLessonCount > 0}}" class="hero-tag">已学 {{course.finishedLessonCount}}/{{course.lessonCount}}</view>
      </view>
      <view class="hero-summary">{{course.summary}}</view>
      <view wx:if="{{!accessible}}" class="hero-btn" bindtap="buy">购买后解锁全部课时</view>
    </view>

    <view wx:if="{{current}}" class="card">
      <view class="card-head">
        <view class="card-title">{{current.title}}</view>
        <view class="card-meta">时长 {{current.durationText}}</view>
      </view>
      <view class="lesson-content" wx:if="{{current.content}}">{{current.content}}</view>
      <view class="lesson-empty" wx:else>该课时暂无可播放内容</view>
      <view class="finish-btn" bindtap="markFinished">标记为已学完</view>
    </view>

    <view class="section-head"><view class="title-bar"></view>课时目录</view>

    <view class="card list-card">
      <view wx:for="{{lessons}}" wx:key="id"
            class="lesson-row {{current && current.id === item.id ? 'active' : ''}}"
            data-id="{{item.id}}" bindtap="play">
        <view class="lesson-index">{{index + 1}}</view>
        <view class="lesson-main">
          <view class="lesson-title">
            {{item.title}}
            <text wx:if="{{item.freePreview}}" class="mini-pill mini-green">试看</text>
            <text wx:if="{{item.locked}}" class="mini-pill mini-gray">未解锁</text>
            <text wx:if="{{item.finished}}" class="mini-pill mini-gray">已完成</text>
          </view>
          <view class="lesson-duration">{{item.durationText}}</view>
        </view>
        <view class="lesson-play">›</view>
      </view>
    </view>
  </block>
</view>
