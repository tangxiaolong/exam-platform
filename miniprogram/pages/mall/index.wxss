.page {
  padding: 24rpx 24rpx 120rpx;
  box-sizing: border-box;
  background: #f5f7fa;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #1d4ed8 0%, #4f46e5 55%, #7c3aed 100%);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  color: #fff;
  box-shadow: 0 12rpx 32rpx rgba(29, 78, 216, 0.25);
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
}

.header-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 10rpx;
}

.coupon-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  background: linear-gradient(135deg, #fff7ed, #fef3c7);
  border: 1rpx solid #fed7aa;
  border-radius: 20rpx;
  padding: 22rpx 26rpx;
}

.coupon-banner:active {
  opacity: 0.85;
}

.coupon-left {
  display: flex;
  align-items: center;
}

.coupon-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: #f59e0b;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
}

.coupon-text {
  font-size: 25rpx;
  color: #9a3412;
}

.coupon-arrow {
  font-size: 32rpx;
  color: #d97706;
}

.state-box {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.product-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.product-name {
  font-size: 31rpx;
  font-weight: 600;
  color: #111827;
  flex: 1;
  min-width: 0;
}

.product-type {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 20rpx;
  color: #1d4ed8;
  background: #eff6ff;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
}

.product-desc {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
  margin-top: 12rpx;
}

.product-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
}

.price-line {
  display: flex;
  align-items: baseline;
}

.price {
  font-size: 38rpx;
  font-weight: 700;
  color: #dc2626;
}

.origin {
  font-size: 23rpx;
  color: #9ca3af;
  text-decoration: line-through;
  margin-left: 14rpx;
}

.buy-btn {
  font-size: 27rpx;
  color: #ffffff;
  font-weight: 500;
  background: linear-gradient(135deg, #2563eb, #4f46e5);
  border-radius: 999rpx;
  padding: 16rpx 44rpx;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.3);
}

.buy-btn:active {
  opacity: 0.8;
}

.tip {
  margin-top: 28rpx;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.7;
  text-align: center;
  padding: 0 20rpx;
}
