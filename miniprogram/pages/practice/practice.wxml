<view class="container">
  <view wx:if="{{loading}}" class="empty">正在准备题目…</view>
  <view wx:elif="{{!current}}" class="empty">该科目下暂无题目</view>

  <block wx:else>
    <view class="card">
      <view class="row">
        <view class="tag">{{mode === 'RANDOM' ? '随机练习' : mode === 'WRONG' ? '错题重练' : '顺序练习'}}</view>
        <view class="muted">{{index + 1}} / {{questions.length}} · 已答 {{answeredCount}} · 答对 {{correctCount}}</view>
      </view>
    </view>

    <view class="card">
      <view class="q-type">{{current.type === 'SINGLE' ? '单选题' : current.type === 'MULTIPLE' ? '多选题' : '判断题'}}</view>
      <view class="stem">{{current.stem}}</view>

      <view wx:for="{{current.options}}" wx:key="key"
            class="option {{selectedMap[item.key] ? 'active' : ''}}"
            data-key="{{item.key}}" bindtap="choose">
        <view class="option-key">{{item.key}}</view>
        <view class="option-text">{{item.text}}</view>
      </view>
    </view>

    <view wx:if="{{result}}" class="card {{result.correct ? 'ok' : 'bad'}}">
      <view class="fb-title">{{result.correct ? '回答正确' : '回答错误'}}</view>
      <view class="muted">标准答案：{{result.standardAnswer}}</view>
      <view class="analysis" wx:if="{{result.analysis}}">解析：{{result.analysis}}</view>
    </view>

    <view wx:if="{{!result}}" class="btn-primary" bindtap="submit">提交答案</view>
    <view wx:else class="btn-primary" bindtap="next">下一题</view>
  </block>
</view>
