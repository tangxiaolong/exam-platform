.page {
  padding: 24rpx 24rpx 120rpx;
  box-sizing: border-box;
  background: #f5f7fa;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #1d4ed8 0%, #4f46e5 55%, #7c3aed 100%);
  border-radius: 28rpx;
  padding: 36rpx 32rpx 32rpx;
  color: #fff;
  box-shadow: 0 12rpx 32rpx rgba(29, 78, 216, 0.25);
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
}

.header-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 10rpx;
}

.stats-row {
  display: flex;
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 20rpx;
  padding: 22rpx 0;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

.state-box {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
}

/* ---------- 科目筛选 ---------- */
.subject-scroll {
  white-space: nowrap;
  margin-top: 20rpx;
}

.subject-chip {
  display: inline-block;
  font-size: 24rpx;
  color: #6b7280;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
  margin-right: 14rpx;
}

.subject-chip.active {
  color: #ffffff;
  background: #1d4ed8;
  border-color: #1d4ed8;
}

.group-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #6b7280;
  margin: 28rpx 8rpx 14rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.record-card:active {
  opacity: 0.88;
}

.record-top {
  display: flex;
  align-items: center;
}

.record-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 12rpx;
}

.mode-pill {
  flex-shrink: 0;
  font-size: 19rpx;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  margin-right: 12rpx;
}

.mode-blue {
  color: #1d4ed8;
  background: #eff6ff;
}

.mode-purple {
  color: #7c3aed;
  background: #f5f3ff;
}

.mode-red {
  color: #dc2626;
  background: #fef2f2;
}

.record-status {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #9ca3af;
}

.record-status.ongoing {
  color: #1d4ed8;
  font-weight: 500;
}

.rate-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.rate-bar {
  flex: 1;
  height: 10rpx;
  border-radius: 999rpx;
  background: #eef2f7;
  overflow: hidden;
}

.rate-bar-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2563eb, #7c3aed);
}

.rate-text {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 21rpx;
  color: #9ca3af;
}

.record-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.record-time {
  font-size: 21rpx;
  color: #c0c7d2;
}

.rate-pct {
  font-size: 21rpx;
  color: #1d4ed8;
}

.load-more {
  text-align: center;
  font-size: 23rpx;
  color: #9ca3af;
  padding: 20rpx 0 10rpx;
}

.load-more.dim {
  color: #c0c7d2;
  font-size: 22rpx;
}
