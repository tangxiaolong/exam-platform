.page {
  padding: 24rpx 24rpx 120rpx;
  box-sizing: border-box;
  background: #f5f7fa;
  min-height: 100vh;
}

.state-box {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.fav-card:active {
  opacity: 0.92;
}

.fav-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.fav-type {
  font-size: 21rpx;
  color: #1d4ed8;
  background: #eff6ff;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.fav-diff {
  font-size: 21rpx;
  color: #b45309;
  background: #fef3c7;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.fav-time {
  margin-left: auto;
  font-size: 21rpx;
  color: #9ca3af;
}

.fav-stem {
  font-size: 28rpx;
  color: #111827;
  line-height: 1.65;
  margin-top: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

/* ---------- 展开区 ---------- */
.fav-expand {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed #e5e7eb;
}

.ans-row {
  display: flex;
  font-size: 25rpx;
  line-height: 1.7;
  margin-top: 4rpx;
}

.ans-label {
  width: 140rpx;
  color: #9ca3af;
  flex-shrink: 0;
}

.ans-value {
  flex: 1;
  min-width: 0;
}

.ans-value.good {
  color: #059669;
  font-weight: 500;
}

.analysis {
  margin-top: 14rpx;
  padding: 18rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.7;
}

/* ---------- 重做 ---------- */
.retry-box {
  margin-top: 20rpx;
}

.retry-hint {
  font-size: 23rpx;
  color: #9ca3af;
  margin-bottom: 14rpx;
}

.retry-option {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  color: #374151;
  border: 1rpx solid #e5e7eb;
  background: #ffffff;
}

.retry-option.active {
  border-color: #1d4ed8;
  background: #eff6ff;
}

.retry-key {
  font-weight: 600;
  margin-right: 12rpx;
}

.retry-result {
  font-size: 25rpx;
  font-weight: 600;
  margin-top: 10rpx;
}

.retry-result.good {
  color: #059669;
}

.retry-result.bad {
  color: #dc2626;
}

.retry-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.retry-btn {
  display: inline-block;
  font-size: 25rpx;
  border-radius: 999rpx;
  padding: 12rpx 34rpx;
}

.retry-btn.primary {
  color: #ffffff;
  font-weight: 500;
  background: linear-gradient(135deg, #2563eb, #4f46e5);
}

.retry-btn.ghost {
  color: #6b7280;
  background: #f3f4f6;
}

.retry-btn.outline {
  color: #1d4ed8;
  border: 1rpx solid #bfdbfe;
  background: #eff6ff;
}

/* ---------- 底部操作 ---------- */
.fav-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f1f5f9;
}

.expand-tip {
  font-size: 22rpx;
  color: #c0c7d2;
}

.remove-btn {
  font-size: 24rpx;
  color: #dc2626;
  background: #fef2f2;
  border: 1rpx solid #fee2e2;
  border-radius: 999rpx;
  padding: 10rpx 30rpx;
}

.remove-btn:active {
  opacity: 0.7;
}
