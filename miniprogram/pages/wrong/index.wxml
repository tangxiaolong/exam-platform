<view class="page">
  <view class="tabs">
    <view class="tab {{source === 'ALL' ? 'active' : ''}}" bindtap="switchSource" data-source="ALL">全部</view>
    <view class="tab {{source === 'EXAM' ? 'active' : ''}}" bindtap="switchSource" data-source="EXAM">考试</view>
    <view class="tab {{source === 'PRACTICE' ? 'active' : ''}}" bindtap="switchSource" data-source="PRACTICE">练习</view>
  </view>

  <scroll-view wx:if="{{subjects.length > 1}}" scroll-x="true" show-scrollbar="{{false}}" class="subject-scroll">
    <view bindtap="switchSubject" data-subject=""
          class="subject-chip {{subjectFilter === '' ? 'active' : ''}}">全部科目</view>
    <view wx:for="{{subjects}}" wx:key="*this" bindtap="switchSubject" data-subject="{{item}}"
          class="subject-chip {{subjectFilter === item ? 'active' : ''}}">{{item}}</view>
  </scroll-view>

  <view wx:if="{{loading}}" class="state-box">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="state-box">还没有错题，继续保持</view>

  <view wx:for="{{list}}" wx:key="key" class="card wrong-card" bindtap="toggle" data-id="{{item.id}}">
    <view class="wrong-meta">
      {{item.sourceText}}<text wx:if="{{item.answeredAt}}"> · {{item.answeredAt}}</text>
    </view>
    <view class="wrong-stem">{{item.stem}}</view>

    <view wx:if="{{expandedId === item.id}}" class="wrong-expand">
      <view class="ans-row"><view class="ans-label">你的答案</view><view class="ans-value bad">{{item.myAnswer}}</view></view>
      <view class="ans-row"><view class="ans-label">正确答案</view><view class="ans-value good">{{item.correctAnswer}}</view></view>
      <view wx:if="{{item.analysis}}" class="analysis">解析：{{item.analysis}}</view>

      <view class="retry-box">
        <view wx:if="{{retry && retry.questionId === item.id}}">
          <view class="retry-hint">重做（选择答案后提交，本地判分）</view>
          <view wx:for="{{retry.options}}" wx:key="key" catchtap="chooseRetryOption" data-key="{{item.key}}"
                class="retry-option {{item.active ? 'active' : ''}}">
            <text class="retry-key">{{item.key}}</text>
            <text>{{item.text}}</text>
          </view>
          <view wx:if="{{retry.submitted}}" class="retry-result {{retry.matched ? 'good' : 'bad'}}">
            {{retry.matched ? '回答正确' : '回答错误，正确答案：' + item.correctAnswer}}
          </view>
          <view class="retry-actions">
            <view wx:if="{{!retry.submitted}}" catchtap="submitRetry" class="retry-btn primary">提交答案</view>
            <view catchtap="closeRetry" class="retry-btn ghost">{{retry.submitted ? '收起' : '取消'}}</view>
          </view>
        </view>
        <view wx:else catchtap="startRetry" data-id="{{item.id}}" class="retry-btn outline">重做此题</view>
      </view>
    </view>
    <view class="expand-tip">{{expandedId === item.id ? '收起' : '展开查看答案'}}</view>
  </view>
</view>
