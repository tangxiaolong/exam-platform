.page {
  padding: 24rpx 24rpx 120rpx;
  box-sizing: border-box;
  background: #f5f7fa;
  min-height: 100vh;
}

.tabs {
  display: flex;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  color: #6b7280;
  padding: 16rpx 0;
  border-radius: 999rpx;
}

.tab.active {
  color: #ffffff;
  font-weight: 600;
  background: linear-gradient(135deg, #2563eb, #4f46e5);
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.3);
}

.subject-scroll {
  white-space: nowrap;
  margin-top: 20rpx;
}

.subject-chip {
  display: inline-block;
  font-size: 24rpx;
  color: #6b7280;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
  margin-right: 14rpx;
}

.subject-chip.active {
  color: #ffffff;
  background: #1d4ed8;
  border-color: #1d4ed8;
}

.state-box {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
}

/* ---------- 错题卡 ---------- */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.wrong-card:active {
  opacity: 0.92;
}

.wrong-meta {
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 12rpx;
}

.wrong-stem {
  font-size: 28rpx;
  color: #111827;
  line-height: 1.65;
}

.expand-tip {
  margin-top: 14rpx;
  text-align: right;
  font-size: 22rpx;
  color: #c0c7d2;
}

.wrong-expand {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed #e5e7eb;
}

.ans-row {
  display: flex;
  font-size: 25rpx;
  line-height: 1.7;
  margin-top: 8rpx;
}

.ans-label {
  width: 140rpx;
  color: #9ca3af;
  flex-shrink: 0;
}

.ans-value {
  flex: 1;
  min-width: 0;
}

.ans-value.bad {
  color: #dc2626;
}

.ans-value.good {
  color: #059669;
}

.analysis {
  margin-top: 16rpx;
  padding: 18rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.7;
}

/* ---------- 重做 ---------- */
.retry-box {
  margin-top: 20rpx;
}

.retry-hint {
  font-size: 23rpx;
  color: #9ca3af;
  margin-bottom: 14rpx;
}

.retry-option {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  color: #374151;
  border: 1rpx solid #e5e7eb;
  background: #ffffff;
}

.retry-option.active {
  border-color: #1d4ed8;
  background: #eff6ff;
}

.retry-key {
  font-weight: 600;
  margin-right: 12rpx;
}

.retry-result {
  font-size: 25rpx;
  font-weight: 600;
  margin-top: 10rpx;
}

.retry-result.good {
  color: #059669;
}

.retry-result.bad {
  color: #dc2626;
}

.retry-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.retry-btn {
  display: inline-block;
  font-size: 25rpx;
  border-radius: 999rpx;
  padding: 12rpx 34rpx;
}

.retry-btn.primary {
  color: #ffffff;
  font-weight: 500;
  background: linear-gradient(135deg, #2563eb, #4f46e5);
}

.retry-btn.ghost {
  color: #6b7280;
  background: #f3f4f6;
}

.retry-btn.outline {
  color: #1d4ed8;
  border: 1rpx solid #bfdbfe;
  background: #eff6ff;
}
