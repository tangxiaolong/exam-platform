<view class="container">
  <view class="hero">
    <view class="hello">Hi，{{nickname}}</view>
    <view class="slogan">选项目 · 刷题库 · 考出好成绩</view>
    <view class="hero-actions">
      <view class="hero-btn" bindtap="toExam">考试中心</view>
      <view class="hero-btn ghost" bindtap="toMall">会员商城</view>
    </view>
  </view>

  <view class="section-title">考试项目</view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{projects.length === 0}}" class="empty">暂无已发布的项目</view>

  <view wx:for="{{projects}}" wx:key="id" class="card project" data-id="{{item.id}}" bindtap="toProject">
    <view class="project-top">
      <view class="project-name">{{item.name}}</view>
      <view class="tag">{{item.code}}</view>
    </view>
    <view class="muted project-intro">{{item.intro || '暂无简介'}}</view>
    <view class="project-foot">
      <text class="muted">{{item.targetAudience || '适用对象不限'}}</text>
      <text class="enter">进入 ›</text>
    </view>
  </view>
</view>
