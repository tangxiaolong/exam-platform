.page {
  padding: 24rpx 24rpx 120rpx;
  box-sizing: border-box;
  background: #f5f7fa;
}

/* ---------- 顶部欢迎区 ---------- */
.hero {
  position: relative;
  background: linear-gradient(135deg, #1d4ed8 0%, #4f46e5 55%, #7c3aed 100%);
  border-radius: 28rpx;
  padding: 40rpx 32rpx 36rpx;
  color: #fff;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(29, 78, 216, 0.25);
}

.hero::after {
  content: '';
  position: absolute;
  right: -90rpx;
  top: -90rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-info {
  flex: 1;
  min-width: 0;
}

.hello {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.slogan {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 12rpx;
}

.hero-badge {
  display: inline-block;
  font-size: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  margin-top: 20rpx;
}

.hero-illustration {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.hero-emoji {
  width: 96rpx;
  height: 96rpx;
  background: url("data:image/svg+xml;base64,") center / contain no-repeat;
}

.hero-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 34rpx;
}

.hero-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.16);
  transition: opacity 0.15s;
}

.hero-btn:active {
  opacity: 0.75;
}

.hero-btn.primary {
  background: #ffffff;
  color: #1d4ed8;
  font-weight: 600;
}

/* ---------- 搜索 ---------- */
.search-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 18rpx 26rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.search-icon {
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
  background: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjOWNhM2FmIiBzdHJva2Utd2lkdGg9IjIiIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCI+PGNpcmNsZSBjeD0iMTEiIGN5PSIxMSIgcj0iNyIvPjxwYXRoIGQ9Im0yMCAyMC0zLjUtMy41Ii8+PC9zdmc+") center / contain no-repeat;
}

.search-input {
  flex: 1;
  font-size: 27rpx;
  color: #1f2937;
}

.search-placeholder {
  color: #9ca3af;
}

/* ---------- 快捷入口宫格 ---------- */
.quick-grid {
  display: flex;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx 12rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-item:active {
  opacity: 0.7;
}

.quick-icon {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
}

.quick-icon::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-position: center;
  background-repeat: no-repeat;
  background-size: 46rpx 46rpx;
}

.icon-book::after {
  background-image: url("data:image/svg+xml;base64,");
}

.icon-bookx::after {
  background-image: url("data:image/svg+xml;base64,");
}

.icon-star::after {
  background-image: url("data:image/svg+xml;base64,");
}

.icon-clock::after {
  background-image: url("data:image/svg+xml;base64,");
}

.quick-blue {
  background: linear-gradient(135deg, #dbeafe, #eff6ff);
}

.quick-red {
  background: linear-gradient(135deg, #fee2e2, #fef2f2);
}

.quick-amber {
  background: linear-gradient(135deg, #fef3c7, #fffbeb);
}

.quick-green {
  background: linear-gradient(135deg, #d1fae5, #ecfdf5);
}

.quick-text {
  font-size: 24rpx;
  color: #374151;
  margin-top: 14rpx;
}

/* ---------- 区块 ---------- */
.section {
  margin-top: 40rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 31rpx;
  font-weight: 600;
  color: #111827;
}

.title-bar {
  width: 8rpx;
  height: 30rpx;
  border-radius: 8rpx;
  background: #1d4ed8;
  margin-right: 14rpx;
}

.section-more {
  font-size: 24rpx;
  color: #6b7280;
}

.section-count {
  font-size: 22rpx;
  color: #9ca3af;
}

/* ---------- 卡片基础 ---------- */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.card:active {
  opacity: 0.85;
}

/* ---------- 公告与活动 ---------- */
.notice-card {
  padding: 10rpx 26rpx;
}

.notice-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.notice-row:last-child {
  border-bottom: none;
}

.notice-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #1d4ed8;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.notice-badge {
  font-size: 20rpx;
  color: #b45309;
  background: #fef3c7;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.notice-text {
  flex: 1;
  font-size: 27rpx;
  color: #374151;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.notice-text-activity {
  color: #b45309;
}

.notice-arrow {
  font-size: 30rpx;
  color: #d1d5db;
  margin-left: 12rpx;
}

/* ---------- 最新推荐 ---------- */
.rec-scroll {
  white-space: nowrap;
}

.rec-card {
  display: inline-block;
  width: 320rpx;
  margin-right: 18rpx;
  background: #ffffff;
  border-radius: 24rpx;
  vertical-align: top;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.rec-card:active {
  opacity: 0.85;
}

.rec-cover {
  height: 120rpx;
  background: linear-gradient(135deg, #dbeafe, #ede9fe);
  display: flex;
  align-items: center;
  justify-content: center;
}

.rec-cover-img {
  display: block;
  width: 100%;
  height: 120rpx;
}

.rec-cover-emoji {
  width: 64rpx;
  height: 64rpx;
  background: url("data:image/svg+xml;base64,") center / contain no-repeat;
}

.rec-body {
  padding: 20rpx 24rpx 24rpx;
  box-sizing: border-box;
}

.rec-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #1d4ed8;
  background: #eff6ff;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.rec-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  white-space: normal;
  line-height: 1.4;
  margin-top: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.rec-intro {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 8rpx;
  line-height: 1.5;
  white-space: normal;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  min-height: 66rpx;
}

.rec-link {
  font-size: 22rpx;
  color: #1d4ed8;
  margin-top: 12rpx;
}

/* ---------- 考试项目列表 ---------- */
.state-box {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
}

.project-card {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding: 28rpx 26rpx;
}

.project-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #dbeafe, #ede9fe);
  color: #1d4ed8;
  font-size: 38rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.project-cover {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
  background: #f1f5f9;
}

.project-main {
  flex: 1;
  min-width: 0;
}

.project-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.project-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.project-code {
  font-size: 20rpx;
  color: #6b7280;
  background: #f3f4f6;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.project-intro {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 10rpx;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.project-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.project-audience {
  font-size: 22rpx;
  color: #9ca3af;
  flex: 1;
  margin-right: 16rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.project-enter {
  font-size: 24rpx;
  color: #1d4ed8;
  font-weight: 500;
  flex-shrink: 0;
}
