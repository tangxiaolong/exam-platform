.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.bar-title {
  font-size: 30rpx;
  font-weight: 600;
}

.countdown {
  font-size: 40rpx;
  font-weight: 700;
  color: #dc2626;
  font-variant-numeric: tabular-nums;
}

.nav {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.nav-item {
  display: inline-block;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 14rpx;
  background: #fff;
  color: #64748b;
  margin-right: 14rpx;
  font-size: 26rpx;
}

.nav-item.active {
  background: #2563eb;
  color: #fff;
}

.nav-item.done {
  background: #dbeafe;
  color: #1d4ed8;
}

.q-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.stem {
  font-size: 30rpx;
  line-height: 1.7;
  margin-bottom: 26rpx;
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.6;
}

.footer {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.footer .btn-ghost {
  flex: 1;
  padding: 20rpx 0;
}

.footer .btn-primary {
  flex: 1.4;
}

.notice {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.7;
}

.essay {
  width: 100%;
  box-sizing: border-box;
  min-height: 300rpx;
  padding: 24rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

.essay-hint {
  margin-top: 14rpx;
  font-size: 24rpx;
}
