.page {
  padding: 16rpx 24rpx 180rpx;
  box-sizing: border-box;
  background: #f5f7fa;
  min-height: 100vh;
}

.state-box {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
}

/* ---------- 吸顶区（信息条 + 题号导航） ---------- */
.sticky-top {
  position: sticky;
  top: 0;
  z-index: 20;
  background: #f5f7fa;
  padding-bottom: 14rpx;
}

.exam-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 22rpx 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.exam-info {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.exam-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #111827;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.exam-progress {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

.pending {
  font-size: 21rpx;
  color: #b45309;
  margin-top: 6rpx;
}

.countdown-box {
  flex-shrink: 0;
  text-align: center;
  background: #fef2f2;
  border: 1rpx solid #fee2e2;
  border-radius: 16rpx;
  padding: 10rpx 22rpx;
}

.countdown-label {
  font-size: 19rpx;
  color: #f87171;
}

.countdown {
  font-size: 40rpx;
  font-weight: 700;
  color: #dc2626;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
  animation: pulse 1.6s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.75;
  }
}

/* ---------- 底部抽屉答题卡 ---------- */
.card-fab {
  position: fixed;
  right: 24rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  z-index: 40;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2563eb, #4f46e5);
  color: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(37, 99, 235, 0.35);
}

.card-fab:active {
  opacity: 0.8;
}

.card-fab-count {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.card-fab-label {
  font-size: 20rpx;
  opacity: 0.92;
  margin-top: 2rpx;
}

.drawer-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.drawer-panel {
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 0 28rpx calc(20rpx + env(safe-area-inset-bottom));
  animation: drawer-up 0.22s ease;
  max-height: 78vh;
  display: flex;
  flex-direction: column;
}

@keyframes drawer-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0 20rpx;
  border-bottom: 1rpx solid #eef2f7;
}

.drawer-title {
  font-size: 31rpx;
  font-weight: 600;
  color: #111827;
}

.drawer-close {
  font-size: 25rpx;
  color: #6b7280;
  padding: 8rpx 10rpx;
}

.drawer-stats {
  display: flex;
  padding: 20rpx 0;
}

.ds-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #eef2f7;
}

.ds-item:last-child {
  border-right: none;
}

.ds-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #334155;
  font-variant-numeric: tabular-nums;
}

.ds-num.done {
  color: #1d4ed8;
}

.ds-num.todo {
  color: #ef4444;
}

.ds-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.drawer-grid-wrap {
  flex: 1;
  min-height: 0;
  padding: 8rpx 0;
}

.drawer-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 0 16rpx;
}

.grid-item {
  width: 84rpx;
  height: 84rpx;
  line-height: 82rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #f8fafc;
  color: #64748b;
  font-size: 27rpx;
  border: 1rpx solid #e5e7eb;
  box-sizing: border-box;
}

.grid-item.done {
  background: #dbeafe;
  color: #1d4ed8;
  border-color: #bfdbfe;
}

.grid-item.active {
  background: #1d4ed8;
  color: #ffffff;
  border-color: #1d4ed8;
  font-weight: 600;
}

.drawer-tip {
  font-size: 21rpx;
  color: #9ca3af;
  text-align: center;
  padding: 4rpx 0 14rpx;
}

.drawer-foot {
  border-top: 1rpx solid #eef2f7;
  padding-top: 20rpx;
}

.drawer-submit {
  text-align: center;
  padding: 22rpx 0;
  border-radius: 999rpx;
  font-size: 29rpx;
  color: #ffffff;
  font-weight: 600;
  background: linear-gradient(135deg, #2563eb, #4f46e5);
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.3);
}

.drawer-submit:active {
  opacity: 0.8;
}

/* ---------- 题目卡 ---------- */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.q-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.q-type {
  font-size: 22rpx;
  color: #1d4ed8;
  background: #eff6ff;
  border-radius: 8rpx;
  padding: 6rpx 18rpx;
}

.q-meta {
  font-size: 22rpx;
  color: #9ca3af;
}

.stem {
  font-size: 30rpx;
  line-height: 1.75;
  margin-bottom: 26rpx;
  color: #111827;
}

/* ---------- 主观题 ---------- */
.essay {
  width: 100%;
  box-sizing: border-box;
  min-height: 300rpx;
  padding: 24rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

.essay-hint {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #9ca3af;
}

/* ---------- 须知 ---------- */
.notice {
  margin-top: 24rpx;
  font-size: 23rpx;
  color: #94a3b8;
  line-height: 1.7;
}

/* ---------- 底部固定操作栏 ---------- */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #eef2f7;
  box-shadow: 0 -6rpx 24rpx rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}

.foot-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #374151;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
}

.foot-btn:active {
  opacity: 0.7;
}

.foot-btn.submit {
  flex: 1.3;
  color: #ffffff;
  font-weight: 600;
  background: linear-gradient(135deg, #2563eb, #4f46e5);
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.3);
}
