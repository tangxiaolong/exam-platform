.score-card {
  background: linear-gradient(135deg, #1d4ed8, #6366f1);
  color: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}

.light {
  color: rgba(255, 255, 255, 0.8);
}

.score {
  font-size: 76rpx;
  font-weight: 700;
  margin: 8rpx 0;
}

.full {
  font-size: 30rpx;
  font-weight: 400;
  opacity: 0.8;
  margin-left: 8rpx;
}

.stat {
  font-size: 24rpx;
  opacity: 0.9;
}

.light-tag {
  display: inline-block;
  margin-top: 18rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.stem {
  font-size: 28rpx;
  line-height: 1.7;
  margin: 16rpx 0;
}

.ok-text {
  color: #059669;
  font-size: 24rpx;
}

.bad-text {
  color: #dc2626;
  font-size: 24rpx;
}

.analysis {
  margin-top: 14rpx;
  padding: 16rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.7;
}
