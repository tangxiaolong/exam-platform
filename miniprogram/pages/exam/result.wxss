.page {
  padding: 24rpx 24rpx 180rpx;
  box-sizing: border-box;
  background: #f5f7fa;
  min-height: 100vh;
}

/* ---------- 成绩 Hero ---------- */
.hero {
  position: relative;
  background: linear-gradient(135deg, #1d4ed8 0%, #4f46e5 55%, #7c3aed 100%);
  border-radius: 28rpx;
  padding: 32rpx;
  color: #fff;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(29, 78, 216, 0.25);
}

.hero-deco {
  position: absolute;
  right: -90rpx;
  top: -90rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-session {
  font-size: 28rpx;
  font-weight: 500;
  opacity: 0.95;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 20rpx;
}

.share-btn {
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  flex-shrink: 0;
  background-image: url("data:image/svg+xml;base64,");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 32rpx 32rpx;
}

.share-btn::after {
  border: none;
}

.score-row {
  display: flex;
  align-items: baseline;
  margin-top: 30rpx;
}

.score-num {
  font-size: 88rpx;
  font-weight: 700;
  line-height: 1.1;
}

.score-full {
  font-size: 28rpx;
  opacity: 0.8;
  margin-left: 12rpx;
}

.score-bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  margin-top: 24rpx;
  overflow: hidden;
}

.score-bar-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ffffff, #c7d2fe);
}

.hero-meta {
  font-size: 23rpx;
  opacity: 0.9;
  margin-top: 18rpx;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.hero-tag {
  font-size: 21rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

/* ---------- 提示卡 ---------- */
.notice-card {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx;
  font-size: 25rpx;
  color: #6b7280;
  line-height: 1.7;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.state-box {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
}

/* ---------- 明细头 ---------- */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 0 18rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 31rpx;
  font-weight: 600;
  color: #111827;
}

.title-bar {
  width: 8rpx;
  height: 30rpx;
  border-radius: 8rpx;
  background: #1d4ed8;
  margin-right: 14rpx;
}

.filter-chips {
  display: flex;
  gap: 12rpx;
}

.chip {
  font-size: 22rpx;
  color: #6b7280;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
}

.chip.on {
  color: #ffffff;
  background: #1d4ed8;
  border-color: #1d4ed8;
}

/* ---------- 明细卡片 ---------- */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
  border-left: 6rpx solid transparent;
  box-sizing: border-box;
}

.item-ok {
  border-left-color: #10b981;
}

.item-bad {
  border-left-color: #ef4444;
}

.item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.item-no {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f1f5f9;
  color: #475569;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #eff6ff;
  color: #2563eb;
}

.item-verdict {
  font-size: 23rpx;
  font-weight: 500;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.stem {
  font-size: 28rpx;
  line-height: 1.7;
  margin: 18rpx 0 14rpx;
  color: #111827;
}

.answer-row {
  display: flex;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 8rpx;
}

.answer-label {
  color: #9ca3af;
  flex-shrink: 0;
  width: 140rpx;
}

.answer-value {
  color: #374151;
  flex: 1;
  min-width: 0;
}

.ok-text {
  color: #059669;
}

.bad-text {
  color: #dc2626;
}

.muted {
  color: #8a94a6;
}

.analysis {
  margin-top: 16rpx;
  padding: 18rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.7;
}

/* ---------- 底部固定操作栏 ---------- */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #eef2f7;
  box-shadow: 0 -6rpx 24rpx rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}

.bottom-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 999rpx;
  font-size: 29rpx;
}

.bottom-btn:active {
  opacity: 0.8;
}

.bottom-btn.ghost {
  color: #1d4ed8;
  background: #eff6ff;
  border: 1rpx solid #dbeafe;
}

.bottom-btn.primary {
  color: #ffffff;
  font-weight: 600;
  background: linear-gradient(135deg, #2563eb, #4f46e5);
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.3);
}

/* ---------- 成绩趋势 / 历史对比 ---------- */
.trend-card {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.trend-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.trend-count {
  font-size: 21rpx;
  color: #9ca3af;
}

.trend-stats {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.trend-stat {
  flex: 1;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 16rpx 0;
  text-align: center;
}

.trend-stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1d4ed8;
  font-variant-numeric: tabular-nums;
}

.trend-stat-num.best {
  color: #059669;
}

.unit {
  font-size: 22rpx;
  font-weight: 500;
  margin-left: 2rpx;
}

.trend-stat-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.trend-bars {
  display: flex;
  align-items: stretch;
  gap: 10rpx;
  height: 200rpx;
  margin-top: 26rpx;
  padding: 0 4rpx;
}

.trend-bar-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.trend-bar-val {
  font-size: 19rpx;
  color: #94a3b8;
  line-height: 1;
  margin-bottom: 6rpx;
  font-variant-numeric: tabular-nums;
}

.trend-bar-track {
  width: 100%;
  flex: 1;
  display: flex;
  align-items: flex-end;
  background: #f1f5f9;
  border-radius: 8rpx;
  overflow: hidden;
}

.trend-bar-fill {
  width: 100%;
  min-height: 8rpx;
  background: #bfdbfe;
  border-radius: 8rpx 8rpx 0 0;
  transition: height 0.3s ease;
}

.trend-bar-fill.current {
  background: linear-gradient(180deg, #4f46e5, #1d4ed8);
}

.trend-bar-label {
  font-size: 19rpx;
  color: #9ca3af;
  line-height: 1;
  margin-top: 8rpx;
  white-space: nowrap;
}

.trend-bar-label.current {
  color: #1d4ed8;
  font-weight: 600;
}

.trend-delta {
  margin-top: 20rpx;
  font-size: 23rpx;
  text-align: center;
  color: #64748b;
}

.trend-delta.up {
  color: #059669;
}

.trend-delta.down {
  color: #dc2626;
}

.trend-delta.flat {
  color: #6b7280;
}

/* ---------- 每题快捷操作 ---------- */
.item-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.act-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #6b7280;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
}

.act-btn.on {
  color: #1d4ed8;
  background: #eff6ff;
  border-color: #bfdbfe;
}

.act-btn:active {
  opacity: 0.7;
}
