<view class="page">
  <view wx:if="{{loading}}" class="state-box">正在进入考试…</view>

  <block wx:else>
    <view class="sticky-top">
      <view class="exam-bar">
        <view class="exam-info">
          <view class="exam-name">{{sessionName}}</view>
          <view class="exam-progress">已答 {{answeredCount}} / {{questions.length}} 题</view>
          <view wx:if="{{pendingCount > 0}}" class="pending">有 {{pendingCount}} 题待同步（网络恢复后自动补交）</view>
        </view>
        <view class="countdown-box">
          <view class="countdown-label">剩余时间</view>
          <view class="countdown">{{remainText}}</view>
        </view>
      </view>

      <!-- 题号导航改为底部抽屉答题卡（点右下角「答题卡」按钮弹出） -->
    </view>

    <view class="card" wx:if="{{current}}">
      <view class="q-head">
        <view class="q-type">{{current.type === 'SINGLE' ? '单选题' : current.type === 'MULTIPLE' ? '多选题' : current.type === 'ESSAY' ? '主观题' : '判断题'}}</view>
        <view class="q-meta">第 {{index + 1}} 题 · {{current.score}} 分</view>
      </view>
      <view class="stem">{{current.stem}}</view>

      <block wx:if="{{current.type === 'ESSAY'}}">
        <textarea class="essay" value="{{essayText}}" placeholder="请作答，输入会自动保存"
                  maxlength="2000" auto-height bindinput="onEssayInput" />
        <view class="essay-hint">主观题需人工阅卷，交卷后由阅卷老师评分</view>
      </block>
      <block wx:else>
        <view wx:for="{{current.options}}" wx:key="key"
              class="option {{selectedMap[item.key] ? 'active' : ''}}"
              data-key="{{item.key}}" bindtap="choose">
          <view class="option-key">{{item.key}}</view>
          <view class="option-text">{{item.text}}</view>
        </view>
      </block>
    </view>

    <view class="notice" wx:if="{{noticeContent}}">考试须知：{{noticeContent}}</view>

    <view class="footer-bar">
      <view class="foot-btn" bindtap="prev">‹ 上一题</view>
      <view class="foot-btn" bindtap="next">下一题 ›</view>
      <view class="foot-btn submit" bindtap="confirmSubmit">{{submitting ? '交卷中…' : '交卷'}}</view>
    </view>

    <view class="card-fab" bindtap="openDrawer">
      <view class="card-fab-count">{{answeredCount}}/{{questions.length}}</view>
      <view class="card-fab-label">答题卡</view>
    </view>

    <view wx:if="{{drawerVisible}}" class="drawer-mask" bindtap="closeDrawer" catchtouchmove="noop">
      <view class="drawer-panel" catchtap="noop">
        <view class="drawer-head">
          <view class="drawer-title">答题卡</view>
          <view class="drawer-close" bindtap="closeDrawer">关闭</view>
        </view>
        <view class="drawer-stats">
          <view class="ds-item">
            <view class="ds-num done">{{answeredCount}}</view>
            <view class="ds-label">已答</view>
          </view>
          <view class="ds-item">
            <view class="ds-num todo">{{questions.length - answeredCount}}</view>
            <view class="ds-label">未答</view>
          </view>
          <view class="ds-item">
            <view class="ds-num">{{questions.length}}</view>
            <view class="ds-label">总题数</view>
          </view>
        </view>
        <scroll-view scroll-y class="drawer-grid-wrap">
          <view class="drawer-grid">
            <view wx:for="{{questions}}" wx:for-index="idx" wx:key="questionId"
                  class="grid-item {{answeredMap[item.questionId] ? 'done' : ''}} {{idx === index ? 'active' : ''}}"
                  data-index="{{idx}}" bindtap="switchFromCard">{{idx + 1}}</view>
          </view>
          <view class="drawer-tip">点题号直接跳转，蓝色为当前题</view>
        </scroll-view>
        <view class="drawer-foot">
          <view class="drawer-submit" bindtap="confirmSubmit">{{submitting ? '交卷中…' : '交卷'}}</view>
        </view>
      </view>
    </view>
  </block>
</view>
