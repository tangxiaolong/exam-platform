.page {
  padding: 24rpx 24rpx 120rpx;
  box-sizing: border-box;
  background: #f5f7fa;
  min-height: 100vh;
}

/* ---------- 头部 ---------- */
.header {
  background: linear-gradient(135deg, #1d4ed8 0%, #4f46e5 55%, #7c3aed 100%);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  color: #fff;
  box-shadow: 0 12rpx 32rpx rgba(29, 78, 216, 0.25);
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
}

.header-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 10rpx;
}

.header-meta {
  display: inline-block;
  margin-top: 20rpx;
  font-size: 21rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

/* ---------- 状态 ---------- */
.state-box {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
}

/* ---------- 场次卡片 ---------- */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.session-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.session-name {
  font-size: 31rpx;
  font-weight: 600;
  color: #111827;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 16rpx;
}

.badge {
  flex-shrink: 0;
  font-size: 21rpx;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.badge-on {
  color: #059669;
  background: #ecfdf5;
}

.badge-off {
  color: #6b7280;
  background: #f3f4f6;
}

.session-info {
  margin-top: 20rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
}

.info-row {
  display: flex;
  font-size: 24rpx;
  line-height: 1.7;
  padding: 4rpx 0;
}

.info-label {
  width: 130rpx;
  color: #9ca3af;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  color: #374151;
}

.ticket {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #1d4ed8;
  background: #eff6ff;
  border: 1rpx solid #dbeafe;
  border-radius: 10rpx;
  padding: 10rpx 18rpx;
  display: inline-block;
}

/* ---------- 操作 ---------- */
.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.action-btn:active {
  opacity: 0.8;
}

.action-btn.primary {
  color: #ffffff;
  font-weight: 600;
  background: linear-gradient(135deg, #2563eb, #4f46e5);
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.3);
}

.action-btn.ghost {
  color: #1d4ed8;
  background: #eff6ff;
  border: 1rpx solid #dbeafe;
}
