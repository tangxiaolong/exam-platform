.page {
  padding: 24rpx 24rpx 120rpx;
  box-sizing: border-box;
  background: #f5f7fa;
  min-height: 100vh;
}

.mark-bar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 16rpx;
}

.mark-all {
  font-size: 24rpx;
  color: #1d4ed8;
  background: #eff6ff;
  border: 1rpx solid #dbeafe;
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
}

.mark-all:active {
  opacity: 0.7;
}

.state-box {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.msg-card.unread {
  border-left: 6rpx solid #1d4ed8;
}

.msg-card:active {
  opacity: 0.9;
}

.msg-head {
  display: flex;
  align-items: center;
}

.msg-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ef4444;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.msg-title {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  color: #111827;
  line-height: 1.5;
}

.msg-card.unread .msg-title {
  font-weight: 600;
}

.msg-time {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 21rpx;
  color: #9ca3af;
}

.msg-content {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e5e7eb;
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.8;
  white-space: pre-wrap;
}

.load-more {
  text-align: center;
  font-size: 23rpx;
  color: #9ca3af;
  padding: 20rpx 0 10rpx;
}

.load-more.dim {
  color: #c0c7d2;
  font-size: 22rpx;
}
