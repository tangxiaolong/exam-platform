.profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #1d4ed8, #4f46e5);
  color: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
}

.name {
  font-size: 34rpx;
  font-weight: 600;
}

.sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

.quick {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 0;
  margin-bottom: 24rpx;
}

.quick-item {
  flex: 1;
  text-align: center;
}

.quick-value {
  font-size: 38rpx;
  font-weight: 700;
  color: #1d4ed8;
}

.ent {
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.attempt {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.attempt-name {
  font-size: 28rpx;
  font-weight: 500;
}

.btn-ghost {
  margin-top: 10rpx;
  color: #ef4444;
  border-color: #fecaca;
}
