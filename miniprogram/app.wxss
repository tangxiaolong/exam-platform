page {
  background: #f5f7fa;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: #1f2937;
  font-size: 28rpx;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.muted {
  color: #8a94a6;
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.btn-primary {
  background: linear-gradient(135deg, #2563eb, #4f46e5);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 22rpx 0;
  text-align: center;
}

.btn-ghost {
  border: 2rpx solid #dbe3ef;
  color: #2563eb;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 18rpx 0;
  text-align: center;
  background: #fff;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #eff6ff;
  color: #2563eb;
}

.tag-green {
  background: #ecfdf5;
  color: #059669;
}

.tag-gray {
  background: #f1f5f9;
  color: #64748b;
}

.empty {
  text-align: center;
  color: #9aa4b2;
  font-size: 26rpx;
  padding: 80rpx 0;
}

.option {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e8edf5;
  margin-bottom: 16rpx;
  background: #fff;
}

.option.active {
  border-color: #2563eb;
  background: #f5f9ff;
}

.option-key {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #eef2f8;
  color: #475569;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.option.active .option-key {
  background: #2563eb;
  color: #fff;
}
